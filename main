            border-radius: 50%;
            background: #f06292;
            cursor: pointer;
            box-shadow: 0 1px 4px rgba(240,98,146,0.4);
            transition: background 0.15s;
        }
        input[type="range"]::-webkit-slider-thumb:hover { background: #e91e8c; }

        .param-actions {
